# Seguridad local (generar con: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
APP_ENCRYPTION_KEY=
# Clave separada para backups; si queda vacía se usa APP_ENCRYPTION_KEY.
# Debe estar fuera del directorio de backups.
BACKUP_ENCRYPTION_KEY=
COOKIE_SECURE=true
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8

# Backups (F26). BACKUP_OFFLINE_DIR debe apuntar a otro dispositivo/medio.
BACKUP_DIR=./backups
BACKUP_OFFLINE_DIR=./backups/offline
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_OFFLINE=1

# Privacidad (F27)
AVISO_PRIVACIDAD_VERSION=2026-11-23
RETENCION_SEGURIDAD_DIAS=365
# Dejar vacío para no auto-borrar comercial/salud hasta definir plazos legales.
RETENCION_COMERCIAL_DIAS=
RETENCION_SALUD_DIAS=

# Hardening HTTP (F24)
ALLOWED_HOSTS=localhost,127.0.0.1
HSTS_ENABLED=false
ENABLE_DOCS=false
MAX_BODY_BYTES=262144
MAX_INTEGRANTES=20
MAX_EXPORT_ROWS=5000
RATE_LIMIT_ENABLED=true

# LLM local por defecto (no usar claves reales en el repositorio).
# Un proveedor externo solo se habilita explícitamente por un ADMIN y recibe
# únicamente conteos/códigos R1-R8, nunca PII ni salud.
LLM_EXTERNAL_ENABLED=false
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL=qwen2.5:7b
OPENAI_TIMEOUT=60
