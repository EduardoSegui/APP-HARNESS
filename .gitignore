# Entornos virtuales y cachés de Python
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# SQLite (base de datos local generada en tiempo de ejecución)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Backups cifrados (nunca versionar)
backups/
*.db.enc
*.db.enc.sha256

# Artefactos crudos de demo (se publican GIF/MP4 finales)
docs/demo/*.webm

# Testing y cobertura
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Herramientas de desarrollo
.ruff_cache/
.mypy_cache/
.pyright/

# Variables de entorno y secretos
.env
.env.*
!.env.example

# IDEs y sistema operativo
.vscode/
.idea/
*.swp
.DS_Store
